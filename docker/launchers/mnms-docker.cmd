@echo off
setlocal


rem Identifier of the Docker image to run.
rem To run an image built locally, change it to the image name passed to the `docker build ...` command.
set "IMAGE_NAME=ghcr.io/emob-lab/mnms-docker:latest"

rem If TRY_PULL_IMAGE_FROM_REGISTRY is defined, fetch the latest version of the Docker image
rem from the container registry before running it (so that you get updates automatically).
rem To run an image built locally, comment out this variable.
set "TRY_PULL_IMAGE_FROM_REGISTRY=1"

rem If FIX_WINDOWS_PATH_SEPARATORS is defined, all the Windows path separators (backslash)
rem appearing on the command line are replaced by '/'.
rem This is because the Docker image runs Linux, which expects '/' as path separator.
rem WARNINGS:
rem  - This conversion affects all the arguments passed to mnms-docker (whether or not they represent a path).
rem    To disable it, comment out this variable.
rem  - No conversion is applied to the paths that may appear INSIDE the JSON settings file or Python script
rem    passed to mnms-docker. The paths in these files must use '/' as path separator,
rem    and need to be fixed manually if not the case.
rem  - Regardless of path separators, all files used by the simulation (the JSON settings file or Python script,
rem    and any file they reference) must be located in the current directory or one of its subdirectories,
rem    and referenced by relative paths.
set "FIX_WINDOWS_PATH_SEPARATORS=1"


rem ---------------------------------------------------------------------------
rem DO NOT MODIFY THE LAUNCHER SCRIPT BELOW
rem ---------------------------------------------------------------------------

rem Check whether Docker is available or not.
where docker >nul 2>&1
if errorlevel 1 (
    echo Error: Docker is not installed ^(or not in PATH^). 1>&2
    exit /b 1
)

rem Check whether the Docker daemon can be reached (with Docker Desktop, it must be started).
docker info >nul 2>&1
if errorlevel 1 (
    echo Error: cannot connect to the Docker daemon. 1>&2
    exit /b 1
)

rem Fetch the latest version of the image if not up to date.
rem If the registry cannot be reached (e.g. offline), fall back to the local copy of the image, if any.
if defined TRY_PULL_IMAGE_FROM_REGISTRY if not "%TRY_PULL_IMAGE_FROM_REGISTRY%"=="0" (
    docker pull "%IMAGE_NAME%" 1>&2
    if errorlevel 1 (
        echo Warning: cannot check for updates of %IMAGE_NAME%, using the local copy of the image ^(if any^). 1>&2
    )
)

rem Path separator conversion, if enabled.
set "args=%*"
if defined FIX_WINDOWS_PATH_SEPARATORS if not "%FIX_WINDOWS_PATH_SEPARATORS%"=="0" (
    if defined args set "args=%args:\=/%"
)

rem Run Docker, with parameters:
rem - `-it`: attach a terminal and keep stdin open, so that the app behaves as when run from a terminal.
rem - `--rm`: delete the container when it exits (otherwise, stopped containers accumulate).
rem - `--volume ...`: mount the current (host) directory as /data in the container.
rem Remark: contrary to the Linux/MacOS launcher, no user mapping here. Thus, the Docker daemon
rem (i.e. most likely Docker Desktop on a Windows host) must be started by the current user,
rem otherwise the output files generated by MnMS will not be owned by the right Windows user.
docker run -it --rm --volume "%CD%:/data" "%IMAGE_NAME%" %args%
exit /b %errorlevel%
