#!/usr/bin/env bash
set -eo pipefail


# Identifier of the Docker image to run.
# To run an image built locally, change it to the image name passed to the `docker build ...` command.
IMAGE_NAME=ghcr.io/emob-lab/mnms-docker:latest

# If TRY_PULL_IMAGE_FROM_REGISTRY is defined, fetch the latest version of the Docker image
# from the container registry before running it (so that you get updates automatically).
# To run an image built locally, comment out this variable.
TRY_PULL_IMAGE_FROM_REGISTRY=1


# -----------------------------------------------------------------------------
# DO NOT MODIFY THE LAUNCHER SCRIPT BELOW
# -----------------------------------------------------------------------------

# Check whether Docker is available or not.
if ! command -v docker >/dev/null 2>&1; then
    echo "Error: Docker is not installed (or not in PATH)." >&2
    exit 1
fi

# Check whether the Docker daemon can be reached (with Docker Desktop, it must be started).
if ! docker info >/dev/null 2>&1; then
    echo "Error: cannot connect to the Docker daemon." >&2
    exit 1
fi

# Detect Docker daemon installed in rootless mode (see https://docs.docker.com/engine/security/rootless/).
# Remark: this installation mode is not the default one nor the most common.
# It is available only on Linux hosts.
if [[ $(docker info --format '{{.SecurityOptions}}') == *rootless* ]]; then
    IS_ROOTLESS=1
fi

# Fetch the latest version of the image if not up to date.
# If the registry cannot be reached (e.g. offline), fall back to the local copy of the image, if any.
if [[ -n $TRY_PULL_IMAGE_FROM_REGISTRY && $TRY_PULL_IMAGE_FROM_REGISTRY != 0 ]]; then
    if ! docker pull "$IMAGE_NAME" >&2; then
        echo "Warning: cannot check for updates of $IMAGE_NAME, using the local copy of the image (if any)." >&2
    fi
fi

# Run Docker, with parameters:
# - `-it`: attach a terminal and keep stdin open, so that the app behaves as when run from a terminal.
# - `--rm`: delete the container when it exits (otherwise, stopped containers accumulate).
# - `--volume ...`: mount the current (host) directory as /data in the container.
# - `--user ...`: use the same user-ID + group-ID of the current host user to execute the process inside
#   the container (to ensure that the output files generated by MnMS end up being owned by the right user
#   in the host filesystem).
# - `--env HOME=...`: assign a home directory to the user inside the container.
if [[ -n $IS_ROOTLESS && $IS_ROOTLESS != 0 ]]; then

    # User must not be remapped in rootless mode: https://docs.docker.com/engine/security/rootless/uid-gid-mapping/
    # Not needed anyway: in this mode, root in the container is mapped to the current host user.
    exec docker run -it --rm --volume "$PWD:/data" "$IMAGE_NAME" "$@"

else
    exec docker run -it --rm --volume "$PWD:/data" --user "$(id -u):$(id -g)" --env HOME=/tmp "$IMAGE_NAME" "$@"
fi
